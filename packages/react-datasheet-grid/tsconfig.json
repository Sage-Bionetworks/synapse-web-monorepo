{
  "extends": "../../shared/tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "target": "esnext",
    "isolatedModules": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "e2e/**/*.ts",
    "example/src/**/*.ts",
    "example/src/**/*.tsx"
  ]
}
