{
  "name": "@sage-bionetworks/react-datasheet-grid",
  "version": "4.11.5-sage.9",
  "private": false,
  "description": "An Excel-like React component to create beautiful spreadsheets.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/style.css": "./dist/style.css",
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "src/style.css",
    "**/*.css"
  ],
  "files": [
    "dist/**/*"
  ],
  "homepage": "https://react-datasheet-grid.netlify.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sage-Bionetworks/synapse-web-monorepo/packages/react-datasheet-grid"
  },
  "keywords": [
    "react",
    "reactjs",
    "spreadsheet",
    "grid",
    "datasheet",
    "excel",
    "airtable",
    "notion",
    "table"
  ],
  "author": "Nicolas Keller (https://github.com/nick-keller)",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist coverage *.tsbuildinfo",
    "e2e": "playwright test",
    "e2e:report": "pnpm exec playwright show-report",
    "example:build": "vite build --config vite.example.config.ts",
    "example:dev": "vite --config vite.example.config.ts",
    "example:preview": "vite preview --config vite.example.config.ts",
    "lint": "oxlint .",
    "prepublishOnly": "pnpm install && pnpm nx run @sage-bionetworks/react-datasheet-grid:build",
    "test": "vitest",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.10",
    "classnames": "^2.5.1",
    "dompurify": "^3.4.14",
    "fast-deep-equal": "^3.1.3",
    "react-resize-detector": "^10.0.1",
    "throttle-debounce": "^3.0.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@juggle/resize-observer": "^3.4.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.19.20",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/throttle-debounce": "^2.1.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "jsdom": "^26.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3",
    "vite": "^8.0.16",
    "vite-config": "workspace:*",
    "vitest": "^4.1.8"
  }
}
