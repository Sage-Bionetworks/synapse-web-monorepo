# See https://help.github.com/ignore-files/ for more about ignoring files.

# css
*.css
*.css.map
!styleguide.setup.css
# react-datasheet-grid authors plain CSS rather than SCSS, so these are sources, not build output
!packages/react-datasheet-grid/src/style.css
!packages/react-datasheet-grid/example/src/index.css

# dependencies
node_modules/

# testing
coverage/
.vitest-attachments/
**/__screenshots__/

# incremental builds
build/
*.tsbuildinfo

.eslintcache

# docs build
/styleguide

# misc
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env overrides (never commit)
.env.local
.env.*.local

# visual studio specific
jsconfig.json

# webstorm specific
.idea
*.iml

#rollup
.rpt2_cache

# dist/build folders created to either deploy to npm or
# to gh-pages
apps/*/dist
packages/*/dist
storybook-static/
src/umd

build-storybook.log
debug-storybook.log

# Nx cache
.nx/cache
.nx/workspace-data

# React Router Framework Mode generated types
.react-router/

apps/portals/*/public/build-date.txt
apps/portals/*/public/deploy-date.txt

.nx/key

# Claude worktrees
.claude/worktrees
# worktree setup sentinel (created during pnpm install in new worktrees)
.pnpm-installing
.pnpm-install.log
