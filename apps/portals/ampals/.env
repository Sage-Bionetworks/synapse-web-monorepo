VITE_PORTAL_NAME="ALS Knowledge Portal"
VITE_PORTAL_DESCRIPTION="Welcome to the ALS Knowledge Portal, a comprehensive resource for ALS researchers. This platform is a core component of the AMP ALS initiative, a public private partnership among the National Institutes of Health (NIH), U.S. Food and Drug Administration (FDA), Foundation for the National Institutes of Health (FNIH), Critical Path Institute (C-Path), industry, academia, foundations, and advocacy groups. Explore rich datasets, build custom cohorts, and access the latest publications to advance your research. Join a collaborative community committed to rapidly advancing the development of effective new treatments for ALS!"
VITE_PORTAL_KEY="ampals"

# Aridhia / C-Path DAP. To point local dev at the C-Path dev hub, create
# apps/portals/ampals/.env.local (gitignored) with:
#   VITE_ARIDHIA_GATEWAY_URL="https://gateway.westus2.c-path-dev.aridhia.io"
#   VITE_ARIDHIA_SUBJECT_TOKEN_ISSUER="sage-dev"
#   VITE_ARIDHIA_FAIR_PORTAL_URL="https://fair.c-path-dev.aridhia.io"
# ...then restart `pnpm start`. Delete the file to go back to production.
VITE_ARIDHIA_GATEWAY_URL="https://gateway.westeurope.dap.c-path.org"
VITE_ARIDHIA_SUBJECT_TOKEN_ISSUER="sage-prod"
VITE_ARIDHIA_FAIR_PORTAL_URL="https://fair.dap.c-path.org"
